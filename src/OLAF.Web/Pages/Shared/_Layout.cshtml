<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<meta name="theme-color" content="#f6f7f9" />
	<title>@ViewData["Title"] - OLAF</title>
	<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
	<link rel="stylesheet" href="~/OLAF.Web.styles.css" asp-append-version="true" />
</head>
<body>
	<div class="app-shell">
		<aside class="sidebar" id="sidebar" aria-label="Main navigation">
			<div class="brand-row">
				<a class="brand" asp-area="" asp-page="/Index" aria-label="OLAF home">
					<span class="brand-mark">O</span><span class="brand-name">OLAF</span>
				</a>
				<button class="drawer-close-button" id="drawerCloseButton" type="button" aria-label="Close navigation"><span></span><span></span></button>
			</div>
			<div class="sidebar-scroll">
				<div class="nav-section-label">WORKSPACE</div>
				<nav class="primary-nav">
					<a class="nav-link active" asp-page="/Index"><span class="nav-icon">▦</span><span class="nav-label">Calendar</span></a>
					<a class="nav-link" href="#"><span class="nav-icon">♙</span><span class="nav-label">Customers</span></a>
					<a class="nav-link" href="#"><span class="nav-icon">♧</span><span class="nav-label">Cleaning staff</span></a>
					<a class="nav-link" href="#"><span class="nav-icon">♧</span><span class="nav-label">Notifications</span><span class="nav-count">3</span></a>
					<a class="nav-link" href="#"><span class="nav-icon">▤</span><span class="nav-label">Reports</span></a>
					<a class="nav-link" href="#"><span class="nav-icon">⚙</span><span class="nav-label">Settings</span></a>
				</nav>
				<div class="nav-section-label administration-label">ADMINISTRATION</div>
				<nav class="primary-nav">
					<a class="nav-link" href="#"><span class="nav-icon">♙</span><span class="nav-label">User management</span></a>
					<a class="nav-link" href="#"><span class="nav-icon">◷</span><span class="nav-label">Audit history</span></a>
				</nav>
			</div>
			<div class="sidebar-bottom">
				<a class="nav-link" href="#"><span class="nav-icon">◉</span><span class="nav-label">Profile</span></a>
				<a class="nav-link" href="#"><span class="nav-icon">⇥</span><span class="nav-label">Sign out</span></a>
				<button class="collapse-button" id="collapseSidebar" type="button" aria-label="Collapse sidebar"><span class="collapse-symbol">‹</span><span class="nav-label">Collapse sidebar</span></button>
			</div>
		</aside>

		<div class="mobile-scrim" id="mobileScrim" aria-hidden="true"></div>
		<div class="app-main">
			<header class="topbar">
				<div class="topbar-side topbar-left"><span class="topbar-context">Workspace</span></div>
				<h1 class="page-title">@ViewData["Title"]</h1>
				<div class="topbar-actions">
					<button class="icon-button notification-button" type="button" aria-label="Notifications">
						<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18 9a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9M10 21h4"/></svg><span class="notification-dot"></span>
					</button>
					<button class="icon-button menu-button" id="mobileMenuButton" type="button" aria-label="Open navigation" aria-expanded="false" aria-controls="sidebar">
						<span></span><span></span><span></span>
					</button>
				</div>
			</header>
			<main class="page-content" role="main">
				@RenderBody()
			</main>
		</div>
	</div>
	<script src="~/js/site.js" asp-append-version="true"></script>
	@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
